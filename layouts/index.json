{{- $places := slice }}
{{- range hugo.Data.places }}
  {{- $places = $places | append (dict
      "slug" .slug
      "name" .name
      "kind" .kind
      "tags" .tags
      "prefecture" .area.prefecture
      "area" .area.label
      "summary" .summary
      "instagram_url" .source.post_url
      "maps_url" .maps_url
      "url" (printf "/places/%s/" .slug | absURL)
      "added_at" .added_at
  ) }}
{{- end }}
{{- $places | jsonify }}
